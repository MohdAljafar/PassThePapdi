generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String         @id @default(cuid())
  googleSub         String         @unique
  email             String         @unique
  name              String
  pictureUrl        String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  createdBoxes      Box[]          @relation("BoxCreator")
  ownedBoxes        Box[]          @relation("CurrentOwner")
  journeyEvents     BoxJourney[]   @relation("JourneyActor")
  journeyFrom       BoxJourney[]   @relation("JourneyFromOwner")
  journeyTo         BoxJourney[]   @relation("JourneyToOwner")
  giftLocations     GiftLocation[]
  receivedTransfers Transfer[]     @relation("TransferRecipient")
  sentTransfers     Transfer[]     @relation("TransferSender")

  @@index([email])
}

model Box {
  id             String         @id @default(cuid())
  boxCode        String         @unique
  imageUrl       String
  note           String?
  currentOwnerId String
  creatorId      String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  creator        User           @relation("BoxCreator", fields: [creatorId], references: [id])
  currentOwner   User           @relation("CurrentOwner", fields: [currentOwnerId], references: [id])
  journeys       BoxJourney[]
  giftLocations  GiftLocation[]
  transfers      Transfer[]

  @@index([currentOwnerId, createdAt])
}

model Transfer {
  id           String         @id @default(cuid())
  boxId        String
  senderId     String
  recipientId  String?
  tokenHash    String         @unique
  status       TransferStatus @default(PENDING)
  message      String?
  createdAt    DateTime       @default(now())
  expiresAt    DateTime
  claimedAt    DateTime?
  giftLocation GiftLocation?
  box          Box            @relation(fields: [boxId], references: [id])
  recipient    User?          @relation("TransferRecipient", fields: [recipientId], references: [id], onDelete: Restrict)
  sender       User           @relation("TransferSender", fields: [senderId], references: [id])

  @@index([senderId, createdAt])
  @@index([recipientId, createdAt])
  @@index([boxId, status])
  @@index([expiresAt, status])
}

model BoxJourney {
  id          String           @id @default(cuid())
  boxId       String
  actorId     String?
  eventType   JourneyEventType
  fromOwnerId String?
  toOwnerId   String
  note        String?
  createdAt   DateTime         @default(now())
  actor       User?            @relation("JourneyActor", fields: [actorId], references: [id])
  box         Box              @relation(fields: [boxId], references: [id])
  fromOwner   User?            @relation("JourneyFromOwner", fields: [fromOwnerId], references: [id])
  toOwner     User             @relation("JourneyToOwner", fields: [toOwnerId], references: [id])

  @@index([boxId, createdAt])
  @@index([toOwnerId, createdAt])
  @@index([fromOwnerId, createdAt])
}

model GiftLocation {
  id         String   @id @default(cuid())
  boxId      String
  userId     String
  transferId String   @unique
  latitude   Float
  longitude  Float
  acceptedAt DateTime @default(now())
  box        Box      @relation(fields: [boxId], references: [id])
  transfer   Transfer @relation(fields: [transferId], references: [id])
  user       User     @relation(fields: [userId], references: [id])

  @@index([acceptedAt])
  @@index([userId, acceptedAt])
  @@index([boxId, acceptedAt])
}

enum TransferStatus {
  PENDING
  CLAIMED
  EXPIRED
}

enum JourneyEventType {
  CREATED
  TRANSFERRED
}
